" Haakon's nvimrc



" Main settings
"
" Set background shell to use (only on Windows)
set shell=cmd.exe
" Map leader key
let mapleader = 'ø'
let maplocalleader = ','
" Use system clipboard
set clipboard=unnamedplus
" Show line numbers (how is this not default on)
set number
" Use relative numbering style
set relativenumber
" Highlight current line
set cursorline
" Case insensitive search
set ignorecase
" Unless you start entering uppercase letters
set smartcase
" Disable bell
set belloff=all
" Set vim to autoindent
set autoindent
" Smartly indent new lines based on context
set smartindent
" Use spaces instead of tab
set expandtab
" Set ruler at column 80 and 100
set colorcolumn=80,100
" Set tab length
set tabstop=4
set softtabstop=4
set shiftwidth=4

